{
  "name": "delta-dsl",
  "private": false,
  "version": "0.0.2",
  "description": "A React DSL for interactive mathematical expressions and visualizations",
  "type": "module",
  "main": "./dist/delta-dsl.cjs",
  "module": "./dist/delta-dsl.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/delta-dsl.js",
      "require": "./dist/delta-dsl.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "math",
    "dsl",
    "formula",
    "react",
    "typescript",
    "visualization"
  ],
  "author": "Eric Dai <Ericdai2000@gmail.com>, Zain Khan <zain6khan@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericdai5/delta-dsl.git"
  },
  "bugs": {
    "url": "https://github.com/ericdai5/delta-dsl/issues"
  },
  "homepage": "https://github.com/ericdai5/delta-dsl#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/lang-javascript": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/legacy-modes": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@uiw/react-codemirror": "^4.0.0",
    "@xyflow/react": "^12.0.0",
    "codemirror": "^6.0.0",
    "d3": "^7.0.0",
    "katex": "^0.16.0",
    "lodash": "^4.0.0",
    "lucide-react": "^0.400.0",
    "mathjs": "^13.0.0",
    "mobx": "^6.0.0",
    "mobx-react-lite": "^4.0.0",
    "mobx-state-tree": "^5.0.0",
    "plotly.js-dist": "^3.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "sideEffects": [
    "*.css",
    "src/**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production",
    "deploy": "rm -rf docs/forge/* && cp -r dist/* docs/forge/",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "prepublishOnly": "npm run test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "dompurify": "^3.2.3",
    "js-beautify": "^1.15.4",
    "prettier-plugin-latex": "^2.0.1",
    "react-intersection-observer": "^9.8.2",
    "react-split": "^2.0.14",
    "react-usestateref": "^1.0.9"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.24.1",
    "@babel/plugin-syntax-decorators": "^7.24.1",
    "@codemirror/autocomplete": "^6.18.7",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.10.1",
    "@codemirror/legacy-modes": "^6.4.0",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.38.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/d3": "^7.4.3",
    "@types/dompurify": "^3.2.0",
    "@types/js-beautify": "^1.14.3",
    "@types/katex": "^0.16.7",
    "@types/lodash-es": "^4.17.12",
    "@types/mathjax": "^0.0.40",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@uiw/react-codemirror": "^4.22.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitejs/plugin-react-swc": "^3.7.1",
    "@xyflow/react": "^12.8.2",
    "ajv": "^8.17.1",
    "codemirror": "^6.0.1",
    "d3": "^7.9.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "husky": "^9.0.11",
    "katex": "^0.16.11",
    "lint-staged": "^15.2.2",
    "lodash": "^4.17.21",
    "lucide-react": "^0.471.0",
    "mathjs": "^13.2.2",
    "mobx": "^6.12.3",
    "mobx-react-lite": "^4.0.7",
    "mobx-state-tree": "^5.4.1",
    "plotly.js-dist": "^3.0.1",
    "prettier": "^3.2.5",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^7.13.0",
    "react-scan": "^0.4.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.2.2",
    "vite": "^5.1.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --cache --fix",
    "*.{js,css,md}": "prettier --write"
  }
}
